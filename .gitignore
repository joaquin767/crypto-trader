node_modules/
.npm-cache/
*.log
# 🔒 CONFIG FILES WITH API KEYS — NEVER COMMIT THESE
config.json
config.bybit.json
config.*.json
# ✅ Template files are safe — they use placeholder values
!config.template.json
coverage/
lcov.info

# Runtime data (learning insights persist across restarts)
learning-insights.json

# Runtime data (persists between sessions)
trade-journal.json
trade-journal.json.bak.*
trade-journal.json.tmp
pending-orders.json
pending-orders.json.tmp
learning-insights.json

# Session logs
logs/
*.log

# Model training data (large, regenerable via scripts/fetch-klines.ts)
data/klines/

# Extended kline history for walk-forward validation (~80MB, refetchable via
# scripts/fetch-klines.ts --days 365). Validation REPORTS in data/validation/
# are committed; the raw candles they were computed from are not.
data/klines-365/

# 🔒 Config backups also carry API keys — config.*.json doesn't match these.
config.json.bak*
config.json.bak-*

# Freqtrade cross-check: generated inputs/outputs and the venv. The strategy,
# config, scripts and README ARE committed — see crosscheck/README.md.
crosscheck/.venv/
crosscheck/user_data/data/
crosscheck/user_data/backtest_results/
crosscheck/entry_signals.json
data/validation/crosscheck/

__pycache__/
*.pyc

# Exported fold feature matrices (~large, regenerate with scripts/export-folds.ts)
data/validation/folds/

# Daily-catalyst research pipeline (specs/daily-catalyst-manual-trading.md §10.2) —
# regenerable snapshots and reports; not committed. data/manual/ (owner-maintained inputs)
# and data/validation/daily/ (gate artifacts) are NOT covered by this and stay committed.
data/snapshots/
reports/

# Backfilled backtest history (specs/daily-catalyst-manual-trading.md §5.10a) — regenerate with
# `npm run backfill`; large and derived from public data, not committed.
data/history/

# Manual trading journal (specs/daily-catalyst-manual-trading.md §5.7/§10.2) — real trade data,
# not a template; never committed. `manual-journal.json*` also covers the persona channel's
# sync-freshness sidecar `manual-journal.sync.json` (§5.15, revision 3) — machine state, not a
# record — and its own `.tmp` write-then-rename file.
manual-journal.json*
manual-journal.sync.json*

# Persona decision channel (specs/daily-catalyst-manual-trading.md §5.15/§10.2, revision 3) — the
# Plan Report is fully derived from the committed decision + that date's report; `reports/` is
# already ignored above, this line documents that `reports/*.decision.md` is covered by it.
reports/*.decision.md

# Farside ETF flow CSVs imported from browser-saved pages (`npm run farside:import`) — third-party data,
# refreshed by the owner; not committed.
data/manual/farside-*.csv
