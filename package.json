{
  "name": "crypto-trader",
  "version": "0.2.0",
  "description": "Expert crypto trading assistant with multi-indicator strategy, learning system, and real-time web dashboard.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "verify": "npm run typecheck && npm run test",
    "start": "node --experimental-strip-types src/main.ts --config ./config.json",
    "dashboard": "node --experimental-strip-types src/main.ts --config ./config.json --port 3081"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@hono/node-server": "^1.0.0"
  },
  "license": "MIT"
}